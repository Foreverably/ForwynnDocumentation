{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "palm",
	"name": "Forwynn Documentation",
	"colors": {
		"primary": "#5865f2",
		"light": "#798df9",
		"dark": "#5865f2"
	},
	"background": {
		"color": {
			"light": "#F8FAFC",
			"dark": "#121211"
		},
		"decoration": "windows"
	},
	"favicon": {
    "light": "/images/darkforwynn.png",
    "dark": "/images/forwynn.png"
  },
	"navigation": {
		"tabs": [
			{
				"tab": "Home",
				"icon": "house",
				"pages": ["index"]
			},
			{
				"tab": "Ticketr",
				"icon": "ticket",
				"pages": [
					{
						"group": "Getting Started",
						"pages": ["ticketr/index", "ticketr/permissions"]
					},
					{
						"group": "Commands",
						"pages": [
							"ticketr/commands/settings",
							"ticketr/commands/ticket",
							"ticketr/commands/transcripts"
						]
					},
					{
						"group": "Configuration",
						"pages": [
							"ticketr/panels",
							"ticketr/modalcomponents",
							"ticketr/logging",
							"ticketr/Transcripts"
						]
					},
					{
						"group": "Plans",
						"pages": ["ticketr/plans"]
					},
					{
						"group": "Help",
						"pages": ["ticketr/faq"]
					}
				]
			},
			{
				"tab": "Castor",
				"icon": "cards",
				"pages": ["castor/index"]
			},
			{
				"tab": "Kycha",
				"icon": "dice",
				"pages": ["kycha/index"]
			},
			{
				"tab": "Astraea",
				"icon": "rocket",
				"pages": ["astraea/index"]
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Discord Server",
					"href": "https://discord.forwynn.net",
					"icon": "discord"
				},
				{
					"anchor": "Ticketr Website",
					"href": "https://ticketr.forwynn.net",
					"icon": "ticket"
				}
			]
		}
	},
	"logo": {
		"light": "https://cdn.forwynn.net/darkforwynn.png",
		"dark": "https://cdn.forwynn.net/forwynn.png"
	},
	"navbar": {
		"links": [
			{
				"label": "Support",
				"href": "https://discord.forwynn.net"
			}
		]
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude"]
	},
	"footer": {
		"socials": {
			"discord": "https://discord.forwynn.net"
		}
	},
	"search": {
		"prompt": "Search"
	},
	"styling": {
		"latex": true
	},
	"metadata": {
		"timestamp": true
	},
	"errors": {
		"404": {
			"redirect": true
		}
	}
}
